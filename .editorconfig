# ALCops Rulebook engine — editor configuration
# LF everywhere (see .gitattributes); PowerShell lint rules live in PSScriptAnalyzerSettings.psd1. See CONTRIBUTING.md.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# The body GitHub wrote for an issue from the form, byte for byte: it has no final line end.
[tests/fixtures/issues/rulebook-change-opened.md]
insert_final_newline = false
